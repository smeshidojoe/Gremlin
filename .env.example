# Токен бота от @BotFather
BOT_TOKEN=

# Админы бота через запятую (доступ к /menu)
ADMIN_IDS=

# Путь к базе (по умолчанию gremlin.sqlite3 в корне проекта)
# DB_PATH=

# Путь к лог-файлу
# LOG_PATH=

# Юзербот-наблюдатель (видит сообщения других ботов). Пусто = выключен.
TG_API_ID=
TG_API_HASH=
# TG_SESSION=
USERBOT_ON=1

# База статистики
# STATS_DB=

# Автобэкап базы: 0 — выключить, KEEP — сколько суточных копий хранить
# BACKUP_ON=1
# BACKUP_DIR=
# BACKUP_KEEP=14

# ---------- Веб-панель (mini app) ----------
# По умолчанию бот сам поднимает быстрый туннель Cloudflare и берёт выданный
# https-адрес: ничего заполнять не нужно. Выключить туннель — TUNNEL_ON=0.
# TUNNEL_ON=1
# WEB_PORT=8081
#
# Туннель поднят отдельным контейнером (сервис tunnel в docker-compose.yml):
# бот тогда не запускает свой cloudflared, а спрашивает адрес у соседа. Так
# ссылка на панель переживает пересборку бота.
# TUNNEL_METRICS=http://tunnel:2000
# WEB_HOST=0.0.0.0
#
# Свой постоянный адрес (домен, реверс-прокси, ngrok, именованный туннель):
# тогда туннель не запускается и кнопка ведёт сюда.
# WEBAPP_URL=https://panel.example.com

# ---------- Нейрофильтр (rubert-tiny2) ----------
# Папка с моделью. По умолчанию tools/models/rubert-tiny2 в корне проекта;
# в docker-compose она монтируется как /app/models/rubert-tiny2.
# Нет файлов — фильтр остаётся в режиме сбора улик и ничего не считает.
# NN_MODEL_DIR=
#
# Файл, куда пишутся теневые вердикты. По умолчанию рядом с логом бота.
# NN_LOG=

# ---------- Распознавание медиа ----------
# Картинки читает tesseract внутри контейнера: включается в меню чата,
# задавать здесь нечего.
#
# Голосовые расшифровывает сторонняя служба. Контракт: POST multipart
# с полем file, ответ {"text": "...", "duration": 12.3}. Подойдёт GigaAM,
# whisper.cpp, faster-whisper — что угодно с такой ручкой. Пусто —
# расшифровка выключена, переключатель в меню ничего не делает.
# ASR_URL=http://asr:8080/transcribe   # служба из папки asr/ (Vosk)
# ASR_TIMEOUT=180
