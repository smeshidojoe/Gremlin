# Токен бота от @BotFather
BOT_TOKEN=

# Админы бота через запятую (доступ к /menu)
ADMIN_IDS=

# Путь к базе (по умолчанию gremlin.sqlite3 в корне проекта)
# DB_PATH=

# Путь к лог-файлу
# LOG_PATH=

# Mini app (необязательно). Публичный HTTPS-адрес страницы аппки — Telegram требует https.
# Пусто = mini app выключен, всё настраивается только через меню бота.
# WEBAPP_URL=https://gremlin.example.com
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8080

# Юзербот-наблюдатель (видит сообщения других ботов). Пусто = выключен.
TG_API_ID=
TG_API_HASH=
# TG_SESSION=
USERBOT_ON=1

# База статистики
# STATS_DB=
