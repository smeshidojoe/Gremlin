# ---------- Слюша: бот-собеседник ----------
# Свой токен: это отдельный бот, не тот, что модерирует.
SLUSHA_BOT_TOKEN=
# Кто владелец: видит список доступа и все чаты. Через запятую.
SLUSHA_ADMIN_IDS=

# Мозги. Вариант 1: Anthropic напрямую.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# Вариант 2: OpenRouter (Kimi, DeepSeek и прочие одним ключом)
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=moonshotai/kimi-k3-20260715

# Вариант 3: локальная модель. Суточный лимит ответов на неё не действует.
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434
# AI_MODEL=gemma3:4b

# Тонкая настройка (значения по умолчанию годятся).
# AI_NUM_CTX=8192
# AI_REPEAT_PENALTY=1.2
# AI_PERSONA_LIMIT=4000
# LORE_BUDGET=1500
